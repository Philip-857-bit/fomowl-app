# FOMOwl Wallet compile-time environment example
# Use with:
# flutter run --dart-define-from-file=.env
# flutter build apk --release --dart-define-from-file=.env

BACKEND_BASE_URL=https://fomowl-backend.onrender.com
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
CONNECTIVITY_CHECK_URL=https://www.google.com

# Push notification registration is disabled unless the Firebase values below
# are provided or PUSH_NOTIFICATIONS_ENABLED is set to true.
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_IOS_BUNDLE_ID=com.fomowl.fomowlWallet

# Hosted Owllet mini apps. When the launch URL is set, opening it in the in-app
# browser loads the full OwlletMiniApp bridge (wallet context + session token).
# ALLOWED_ORIGINS is an optional comma-separated list of extra trusted origins
# (the launch URL's own origin is always trusted).
CASH_IN_MINI_APP_URL=https://cashin.owlletapp.com
CASH_IN_MINI_APP_ALLOWED_ORIGINS=
AFFILIATE_MINI_APP_URL=https://affiliate.owlletapp.com
AFFILIATE_MINI_APP_ALLOWED_ORIGINS=

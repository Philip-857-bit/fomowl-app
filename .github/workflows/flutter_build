name: Flutter CI/CD Build

on:
  push:
    branches: [ "master", "main" ]
  pull_request:
    branches: [ "master", "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
      - uses: actions/checkout@v3

      - name: Setup Java
        uses: actions/setup-java@v3
        with:
          distribution: 'zulu'
          java-version: '17'
          
      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          
      - name: Install Dependencies
        run: flutter pub get
        working-directory: ./fomowl_wallet

      - name: Run Analyze
        run: flutter analyze
        working-directory: ./fomowl_wallet
        
      - name: Build APK (Fat)
        run: flutter build apk --release
        working-directory: ./fomowl_wallet
        
      - name: Build APK (Split ABI)
        run: flutter build apk --split-per-abi --release
        working-directory: ./fomowl_wallet
        
      - name: Build App Bundle (AAB)
        run: flutter build appbundle --release
        working-directory: ./fomowl_wallet
        
      - name: Upload APKs
        uses: actions/upload-artifact@v4
        with:
          name: fomowl-apks
          path: |
            fomowl_wallet/build/app/outputs/flutter-apk/app-release.apk
            fomowl_wallet/build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk
            fomowl_wallet/build/app/outputs/flutter-apk/app-arm64-v8a-release.apk
            fomowl_wallet/build/app/outputs/flutter-apk/app-x86_64-release.apk

      - name: Upload AAB
        uses: actions/upload-artifact@v4
        with:
          name: fomowl-aab
          path: fomowl_wallet/build/app/outputs/bundle/release/app-release.aab
